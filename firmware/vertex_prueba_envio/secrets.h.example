// Copia este archivo como "secrets.h" (en esta misma carpeta) y pon tus datos.
// secrets.h está excluido de git: nunca lo subas.
// Las redes deben ser de 2,4 GHz. El ESP32 usa la disponible con mejor señal.
// Los nombres distinguen mayúsculas y minúsculas.
#define WIFI_SSID "nombre-de-tu-red"
#define WIFI_PASS "contraseña-de-tu-red"

// Segunda red (opcional), por ejemplo la zona Wi-Fi del celular.
// Si no la usas, borra estas dos líneas.
#define WIFI_SSID_2 "nombre-zona-wifi-celular"
#define WIFI_PASS_2 "contraseña-zona-wifi-celular"

// ETAPA 4: envío a la API.
// VX_URL: pruebas en la red local "http://<IP del PC>:3000"; servidor "https://vertex.sinerbyte.com".
// VX_DISPOSITIVO y VX_CLAVE: los del registro con database/scripts/07_registrar_dispositivo.sql.
#define VX_URL "https://vertex.sinerbyte.com"
#define VX_DISPOSITIVO "ESP32-CERO011-01"
#define VX_CLAVE "clave-del-dispositivo"
