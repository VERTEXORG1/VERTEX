{
  "name": "vertex-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:export": "tsx --env-file=.env scripts/export-db-to-excel.ts",
    "seed:mediciones": "tsx --env-file=.env scripts/seed-mediciones.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "exceljs": "^4.4.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
